Testing zone group declarations, namespace validation, ubus loading,
unknown member dropping, nested group rejection, and empty/disabled flagging.

-- Testcase --
{%
	include("./root/usr/share/firewall4/main.uc", {
		getenv: function(varname) {
			switch (varname) {
			case 'ACTION':
				return 'print';
			}
		}
	});

	let fw4 = require("fw4");

	// Verify valid named group
	let trusted = fw4.get_zone_group("trusted");
	if (!trusted)
		die("trusted zone group missing\n");
	if (trusted.enabled != true || trusted.empty != false)
		die("trusted state invalid\n");
	if (length(trusted.zones) != 1 || trusted.zones[0].name != "lan")
		die("trusted member invalid\n");
	if (trusted.description != "Trusted LAN network")
		die("trusted description invalid\n");

	// Verify valid anonymous group
	let untrusted = fw4.get_zone_group("untrusted");
	if (!untrusted || length(untrusted.zones) != 1 || untrusted.zones[0].name != "wan")
		die("untrusted zone group invalid\n");

	// Verify valid ubus group with multiple zones
	let ubus_grp = fw4.get_zone_group("ubus_group");
	if (!ubus_grp || length(ubus_grp.zones) != 2 || ubus_grp.zones[0].name != "lan" || ubus_grp.zones[1].name != "wan")
		die("ubus_group zone group invalid\n");

	// Verify multi zone group (list feature)
	let multi = fw4.get_zone_group("multi_zone");
	if (!multi || multi.empty != false || length(multi.zones) != 2)
		die("multi_zone length invalid\n");
	if (multi.zones[0].name != "lan" || multi.zones[1].name != "wan")
		die("multi_zone member invalid\n");
	if (length(multi.zone) != 2 || multi.zone[0] != "lan" || multi.zone[1] != "wan")
		die("multi_zone zone invalid\n");

	// Verify deduplication of repeated member zones
	let dedup = fw4.get_zone_group("dedup_group");
	if (!dedup || dedup.empty != false || length(dedup.zones) != 2)
		die("dedup_group length invalid\n");
	if (dedup.zones[0].name != "lan" || dedup.zones[1].name != "wan")
		die("dedup_group member invalid\n");
	if (length(dedup.zone) != 2 || dedup.zone[0] != "lan" || dedup.zone[1] != "wan")
		die("dedup_group zone invalid\n");

	// Verify collision with zone rejected
	if (fw4.get_zone_group("lan"))
		die("colliding zone group 'lan' should not exist\n");
	if (fw4.get_zone_group("wan"))
		die("colliding zone group 'wan' should not exist\n");

	// Verify partial member dropping & retention
	let partial = fw4.get_zone_group("partial");
	if (!partial || partial.empty != false || length(partial.zones) != 1 || partial.zones[0].name != "lan")
		die("partial zone group invalid\n");

	let ubus_partial = fw4.get_zone_group("ubus_partial");
	if (!ubus_partial || ubus_partial.empty != false || length(ubus_partial.zones) != 1 || ubus_partial.zones[0].name != "lan")
		die("ubus_partial zone group invalid\n");

	// Verify nested group rejection & retention of valid member
	let nested = fw4.get_zone_group("nested_group");
	if (!nested || nested.empty != false || length(nested.zones) != 1 || nested.zones[0].name != "lan")
		die("nested_group invalid\n");

	// Verify disabled group flagged empty
	let disabled = fw4.get_zone_group("disabled_group");
	if (!disabled || disabled.enabled != false || disabled.empty != true || length(disabled.zones) != 0)
		die("disabled_group should be empty\n");

	// Verify empty group flagged empty
	let empty = fw4.get_zone_group("empty_group");
	if (!empty || empty.empty != true || length(empty.zones) != 0)
		die("empty_group should be empty\n");
%}
